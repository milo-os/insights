# Insights UI Environment Configuration

# Base URL for the Kubernetes API proxy
# For development with kubectl proxy: http://localhost:8001
# For production with in-cluster service account: leave empty for relative paths
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Default namespace to use for API calls
NEXT_PUBLIC_DEFAULT_NAMESPACE=default

# Enable mock data mode for development without a live backend
NEXT_PUBLIC_USE_MOCK_DATA=false
